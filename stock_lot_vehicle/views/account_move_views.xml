<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.vehicle</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="product_is_vehicle" column_invisible="1"/>
                <button
                    name="action_assign_vehicle_plates"
                    type="object"
                    string="Asignar matrículas"
                    class="btn-link"
                    invisible="not product_is_vehicle"/>
            </xpath>
        </field>
    </record>
</odoo>
