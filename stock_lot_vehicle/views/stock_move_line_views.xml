<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.vehicle</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="product_is_vehicle" column_invisible="1"/>
                <field name="motor_serial" readonly="0" force_save="1"
                    required="product_is_vehicle and (lot_id or lot_name)"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.detailed.vehicle</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="product_is_vehicle" column_invisible="1"/>
                <field name="motor_serial" readonly="0" force_save="1"
                    required="product_is_vehicle and (lot_id or lot_name)"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_form" model="ir.ui.view">
        <field name="name">stock.move.line.form.vehicle</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="product_is_vehicle" invisible="1"/>
                <field name="motor_serial" readonly="0" force_save="1"
                    required="product_is_vehicle and (lot_id or lot_name)"/>
            </field>
        </field>
    </record>
</odoo>
